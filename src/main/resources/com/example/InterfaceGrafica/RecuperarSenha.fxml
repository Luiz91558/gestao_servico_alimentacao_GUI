<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.InterfaceGrafica.TelaRecuperarSenhaController">
   <children>
      <Label alignment="CENTER" layoutX="130.0" layoutY="14.0" prefHeight="46.0" prefWidth="318.0" text="Recuperação de senha">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="102.0" layoutY="117.0" text="Digite seu login:" />
      <TextField fx:id="txtLoginRecSenha" layoutX="102.0" layoutY="155.0" prefHeight="26.0" prefWidth="299.0" />
      <TextField fx:id="txtDicaSenha" layoutX="102.0" layoutY="268.0" prefHeight="26.0" prefWidth="299.0" />
      <Label layoutX="100.0" layoutY="214.0" text="Digite sua dica senha cadastrada:" />
      <Button layoutX="409.0" layoutY="325.0" mnemonicParsing="false" onAction="#validarRecuperacaoDeSenha" text="Confirmar" />
      <Button layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#voltar" text="Voltar" />
   </children>
</AnchorPane>
